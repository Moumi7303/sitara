{
  "task": "enforce_database_storage_integrity",
  "project": "sitara_ai_decision_engine_backend",
  "objective": "Ensure all user data and system data are stored in correct database tables with proper validation, relationships, and consistency",
  "strict_rules": [
    "ALL incoming data must be validated before storage",
    "NO data should be processed without storing it first",
    "EVERY feature must persist data in database",
    "USE Eloquent models only (no raw queries unless necessary)",
    "ENSURE foreign key relationships are enforced"
  ],
  "tables": {
    "users": {
      "fields": ["id", "name", "email", "password", "created_at"],
      "rules": [
        "Email must be unique",
        "Password must be hashed using bcrypt",
        "User must be created on registration"
      ]
    },
    "api_keys": {
      "fields": ["id", "user_id", "encrypted_key", "status"],
      "rules": [
        "API key must be encrypted before saving",
        "Each key must belong to a user",
        "Only one active key per user"
      ]
    },
    "decisions": {
      "fields": ["id", "user_id", "query", "domain", "confidence_score"],
      "rules": [
        "Store user query before processing",
        "Store domain classification result",
        "Store confidence score after AI response"
      ]
    },
    "decision_outputs": {
      "fields": [
        "decision_id",
        "recommendation",
        "pros",
        "cons",
        "risks",
        "alternatives"
      ],
      "rules": [
        "Must be linked to decisions table",
        "Store structured AI output as JSON",
        "Ensure all fields exist before saving"
      ]
    },
    "memory": {
      "fields": ["id", "user_id", "type", "content"],
      "rules": [
        "Store user preferences and context",
        "Link to user_id",
        "Allow future embedding support"
      ]
    },
    "audit_logs": {
      "fields": ["id", "user_id", "action", "status", "metadata"],
      "rules": [
        "Log every important action",
        "Store success or failure",
        "Capture metadata (API calls, errors)"
      ]
    }
  },
  "steps": [
    {
      "step": "validation_layer",
      "actions": [
        "Create Form Request validation classes",
        "Validate all inputs before processing",
        "Reject invalid requests"
      ]
    },
    {
      "step": "model_relationships",
      "actions": [
        "User hasMany Decisions",
        "Decision belongsTo User",
        "Decision hasOne DecisionOutput",
        "User hasOne APIKey",
        "User hasMany Memory"
      ]
    },
    {
      "step": "controller_logic",
      "actions": [
        "Store request data immediately after validation",
        "Use transactions for critical operations",
        "Rollback on failure"
      ]
    },
    {
      "step": "decision_flow_storage",
      "flow": [
        "Validate user input",
        "Insert into decisions table",
        "Call AI API",
        "Parse response",
        "Insert into decision_outputs",
        "Update decisions with confidence_score"
      ]
    },
    {
      "step": "api_key_storage",
      "flow": [
        "Validate API key",
        "Encrypt API key",
        "Store in api_keys table",
        "Mark as active"
      ]
    },
    {
      "step": "logging",
      "actions": [
        "Log every API request",
        "Log failures and errors",
        "Store logs in audit_logs table"
      ]
    }
  ],
  "constraints": [
    "NO data loss allowed",
    "NO direct API response without saving",
    "NO storing plaintext API keys",
    "NO orphan records (must have relationships)",
    "ALL tables must use timestamps"
  ],
  "debug_checks": [
    "Check if user is stored after registration",
    "Check if API key is encrypted in DB",
    "Check if decisions are saved before AI call",
    "Check if decision_outputs linked correctly",
    "Check audit_logs are recording actions"
  ],
  "output": {
    "result": "Fully structured and consistent database system",
    "quality": "production-grade data integrity"
  }
}