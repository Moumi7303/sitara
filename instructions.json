{
  "task": "create_tinker_diagnostic_and_autofix_script",
  "project": "sitara_ai_decision_engine_backend",
  "objective": "Create a Laravel Tinker-compatible script that tests the entire system (database, models, relationships, API flow) and attempts safe fixes for detected issues",
  "strict_mode": true,
  "rules": [
    "DO NOT modify core business logic files",
    "ONLY fix safe and recoverable issues",
    "LOG all errors and fixes",
    "DO NOT delete user data",
    "RUN all checks sequentially"
  ],
  "file_creation": {
    "file_name": "tinker_test.php",
    "location": "project_root",
    "execution": "php artisan tinker < tinker_test.php"
  },
  "checks": [
    {
      "check": "database_connection",
      "actions": [
        "Test DB connection",
        "If failed → log error and stop execution"
      ]
    },
    {
      "check": "tables_exist",
      "tables": [
        "users",
        "api_keys",
        "decisions",
        "decision_outputs",
        "memory",
        "audit_logs"
      ],
      "actions": [
        "Check if each table exists",
        "If missing → run migration automatically"
      ]
    },
    {
      "check": "model_integrity",
      "actions": [
        "Check User model works",
        "Check Decision model works",
        "Check relationships",
        "If broken → log error"
      ]
    },
    {
      "check": "data_presence",
      "actions": [
        "Count records in each table",
        "If empty → run seeders"
      ]
    },
    {
      "check": "api_key_security",
      "actions": [
        "Check if API keys are encrypted",
        "If plaintext found → encrypt immediately"
      ]
    },
    {
      "check": "decision_flow",
      "actions": [
        "Create test decision",
        "Simulate AI response",
        "Store in decision_outputs",
        "Verify linkage"
      ]
    },
    {
      "check": "logging_system",
      "actions": [
        "Insert test audit log",
        "Verify log saved",
        "If failed → log issue"
      ]
    }
  ],
  "auto_fix_rules": [
    {
      "issue": "missing_tables",
      "fix": "run php artisan migrate"
    },
    {
      "issue": "empty_database",
      "fix": "run php artisan db:seed"
    },
    {
      "issue": "plaintext_api_keys",
      "fix": "encrypt using Laravel Crypt"
    },
    {
      "issue": "missing_relationship_data",
      "fix": "create default linked records"
    }
  ],
  "expected_script_structure": [
    "echo 'Starting Sitara Diagnostic...';",
    "try {",
    "  DB::connection()->getPdo();",
    "  echo 'Database connected';",
    "} catch (Exception $e) {",
    "  echo 'DB Error';",
    "  return;",
    "}",
    "",
    "// Check tables",
    "if (!Schema::hasTable('users')) {",
    "  echo 'Users table missing, migrating...';",
    "  Artisan::call('migrate');",
    "}",
    "",
    "// Check data",
    "if (User::count() === 0) {",
    "  echo 'No users found, seeding...';",
    "  Artisan::call('db:seed');",
    "}",
    "",
    "// Test insert",
    "$user = User::first();",
    "$decision = Decision::create([",
    "  'user_id' => $user->id,",
    "  'query' => 'Test decision',",
    "  'domain' => 'test',",
    "  'confidence_score' => 0",
    "]);",
    "",
    "echo 'Decision test created';"
  ],
  "execution_steps": [
    "Create tinker_test.php in root",
    "Run: php artisan tinker < tinker_test.php",
    "Observe console output"
  ],
  "constraints": [
    "Do not overwrite existing user data",
    "Do not delete records",
    "Only safe fixes allowed",
    "Script must not crash entire system"
  ],
  "output": {
    "result": "Full system diagnostic with auto-repair",
    "coverage": "database, models, relationships, basic flow"
  }
}